# ============================================================
# JARVIS - Environment Variables Template
# Copy this file to backend/.env and fill in your real values
# NEVER commit real .env to git
# ============================================================

# --- App Settings ---
APP_NAME=Jarvis
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-random-64-character-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider: "gemini" | "nvidia" | "ollama" | "auto" ---
# "auto" = use Gemini/NVIDIA if online, fallback to Ollama if offline
DEFAULT_AI_PROVIDER=auto
LLM_PROVIDER=auto

# --- Gemini API (Free tier - get from aistudio.google.com) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- NVIDIA NIM API (get from build.nvidia.com) ---
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Ollama (Local - runs on your machine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://jarvis_user:jarvis_password@localhost:5432/jarvis_db

# --- Voice - Faster Whisper (STT) ---
WHISPER_MODEL_SIZE=tiny

# --- Voice - ElevenLabs TTS (Optional - for high-quality / Tamil voice) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0

# --- Memory & Privacy ---
MEMORY_ENCRYPTION_KEY=change-this-to-a-random-32-character-key
MAX_CONVERSATION_HISTORY=50

# --- Search & Documents ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
MAX_DOCUMENT_SIZE_MB=10

# --- Production Hardening ---
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
JARVIS_TIMING_LOG_PATH=scratch/server_timings.jsonl

# --- CORS (Frontend URL) ---
FRONTEND_URL=http://localhost:5173
